-- Migración v4 -> v5: registros de peso corporal (ver WeightEntry.sq). Idempotente.
CREATE TABLE IF NOT EXISTS WeightEntryEntity (
    date TEXT NOT NULL PRIMARY KEY CHECK (length(date) = 10),
    weight_kg REAL NOT NULL CHECK (weight_kg >= 20 AND weight_kg <= 500),
    created_at INTEGER NOT NULL,
    updated_at INTEGER NOT NULL
);
