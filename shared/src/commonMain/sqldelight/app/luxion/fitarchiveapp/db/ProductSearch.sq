-- Índice de búsqueda por texto (FTS5) sobre ProductEntity.
-- Tabla FTS independiente (no external-content). Su rowid es el rowid de ProductEntity: así los triggers
-- borran por rowid (O(log n)) en vez de recorrer toda la tabla FTS por `barcode` (UNINDEXED), que hacía
-- cuadrática la importación de la base genérica (~7 800 filas: 6,5 s -> ver GenericFoodBenchmarkTest).
-- Para que el rowid no cambie al actualizar, `ProductEntity.upsert` usa ON CONFLICT DO UPDATE (no REPLACE).
-- No ejecutar VACUUM: puede renumerar rowids de tablas sin INTEGER PRIMARY KEY y desincronizaría el índice.
-- Cualquier cambio aquí debe replicarse en una migración numerada (.sqm).
CREATE VIRTUAL TABLE ProductFts USING fts5(
    name,
    brand,
    barcode UNINDEXED,
    tokenize = 'unicode61 remove_diacritics 2'
);

CREATE TRIGGER product_fts_insert AFTER INSERT ON ProductEntity BEGIN
    DELETE FROM ProductFts WHERE rowid = new.rowid;
    INSERT INTO ProductFts(rowid, name, brand, barcode) VALUES (new.rowid, new.name, new.brand, new.barcode);
END;

CREATE TRIGGER product_fts_update AFTER UPDATE ON ProductEntity BEGIN
    DELETE FROM ProductFts WHERE rowid = old.rowid;
    INSERT INTO ProductFts(rowid, name, brand, barcode) VALUES (new.rowid, new.name, new.brand, new.barcode);
END;

CREATE TRIGGER product_fts_delete AFTER DELETE ON ProductEntity BEGIN
    DELETE FROM ProductFts WHERE rowid = old.rowid;
END;

-- `query` debe ser una expresión FTS5 ya saneada (ver ProductSearchQuery); mejores coincidencias primero.
search:
SELECT p.*
FROM ProductFts
JOIN ProductEntity AS p ON p.barcode = ProductFts.barcode
WHERE ProductFts MATCH ?
ORDER BY bm25(ProductFts, 10.0, 3.0), p.name
LIMIT ?;
