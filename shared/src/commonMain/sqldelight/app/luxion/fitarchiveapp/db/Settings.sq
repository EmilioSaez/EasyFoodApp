-- Ajustes del usuario: una única fila (id = 1).
-- meals_per_day: comidas al día (3 a 6); NULL = aún sin elegir (dispara la pantalla de primera vez).
CREATE TABLE SettingsEntity (
    id INTEGER NOT NULL PRIMARY KEY CHECK (id = 1),
    meals_per_day INTEGER CHECK (meals_per_day IS NULL OR (meals_per_day >= 3 AND meals_per_day <= 6))
);

selectMealsPerDay:
SELECT meals_per_day FROM SettingsEntity WHERE id = 1;

upsertMealsPerDay:
INSERT INTO SettingsEntity(id, meals_per_day) VALUES (1, ?)
ON CONFLICT(id) DO UPDATE SET meals_per_day = excluded.meals_per_day;
