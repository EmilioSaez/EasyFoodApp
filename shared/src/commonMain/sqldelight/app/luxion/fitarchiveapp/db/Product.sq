-- Caché local de productos. Valores nutricionales por 100 g (o 100 ml); NULL = dato no disponible.
CREATE TABLE ProductEntity (
    barcode TEXT NOT NULL PRIMARY KEY,
    name TEXT NOT NULL,
    brand TEXT,
    image_url TEXT,
    kcal REAL,
    protein_g REAL,
    carbs_g REAL,
    sugars_g REAL,
    fat_g REAL,
    saturated_fat_g REAL,
    fiber_g REAL,
    salt_g REAL,
    serving_size_g REAL,
    serving_label TEXT,
    -- Origen del dato: OPEN_FOOD_FACTS, GENERIC o CUSTOM.
    source TEXT NOT NULL DEFAULT 'OPEN_FOOD_FACTS',
    -- Instante de la última descarga/edición, en milisegundos epoch.
    cached_at INTEGER NOT NULL
);

CREATE INDEX product_name_idx ON ProductEntity(name);
CREATE INDEX product_source_idx ON ProductEntity(source);

selectByBarcode:
SELECT * FROM ProductEntity WHERE barcode = ?;

selectAll:
SELECT * FROM ProductEntity ORDER BY name;

-- ON CONFLICT DO UPDATE (no INSERT OR REPLACE): conserva el rowid, del que depende el índice ProductFts.
upsert:
INSERT INTO ProductEntity(
    barcode, name, brand, image_url, kcal, protein_g, carbs_g, sugars_g, fat_g,
    saturated_fat_g, fiber_g, salt_g, serving_size_g, serving_label, source, cached_at
) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)
ON CONFLICT(barcode) DO UPDATE SET
    name = excluded.name, brand = excluded.brand, image_url = excluded.image_url, kcal = excluded.kcal,
    protein_g = excluded.protein_g, carbs_g = excluded.carbs_g, sugars_g = excluded.sugars_g,
    fat_g = excluded.fat_g, saturated_fat_g = excluded.saturated_fat_g, fiber_g = excluded.fiber_g,
    salt_g = excluded.salt_g, serving_size_g = excluded.serving_size_g, serving_label = excluded.serving_label,
    source = excluded.source, cached_at = excluded.cached_at;

deleteByBarcode:
DELETE FROM ProductEntity WHERE barcode = ?;

countBySource:
SELECT count(*) FROM ProductEntity WHERE source = ?;

-- Versión de los datos de la base genérica ya importados (una única fila, id = 1). Permite reimportar cuando el
-- recurso embebido cambia (p. ej. nombres en español) sin tocar las filas de otros orígenes. Sin fila = 0.
CREATE TABLE GenericFoodsMetaEntity (
    id INTEGER NOT NULL PRIMARY KEY CHECK (id = 1),
    data_version INTEGER NOT NULL
);

selectGenericDataVersion:
SELECT data_version FROM GenericFoodsMetaEntity WHERE id = 1;

upsertGenericDataVersion:
INSERT INTO GenericFoodsMetaEntity(id, data_version) VALUES (1, ?)
ON CONFLICT(id) DO UPDATE SET data_version = excluded.data_version;

-- Seguimiento del refresco de productos de Open Food Facts (ver 14.sqm). Tabla aparte de ProductEntity: no altera la
-- caché ni choca con otras migraciones. Sin fila = nunca refrescado.
--  refreshed_at   última vez que OFF confirmó o actualizó el producto (ms epoch).
--  checked_at     última vez que respondió (también si ya no existe o se rechazó el dato nuevo).
--  changed_at / change_summary   último cambio nutricional relevante y su resumen legible.
CREATE TABLE ProductRefreshEntity (
    barcode TEXT NOT NULL PRIMARY KEY,
    refreshed_at INTEGER,
    checked_at INTEGER,
    changed_at INTEGER,
    change_summary TEXT
);

CREATE TRIGGER product_refresh_delete AFTER DELETE ON ProductEntity BEGIN
    DELETE FROM ProductRefreshEntity WHERE barcode = old.barcode;
END;

selectRefreshInfo:
SELECT refreshed_at, changed_at, change_summary FROM ProductRefreshEntity WHERE barcode = ?;

-- Refresco de un producto de Open Food Facts: solo toca filas de ese origen (nunca genéricos ni propios) y deja
-- intacto el diario, que guarda su propia copia de los valores. Conserva el rowid (índice ProductFts).
updateRefreshed:
UPDATE ProductEntity SET
    name = :name, brand = :brand, image_url = :imageUrl, kcal = :kcal, protein_g = :proteinG, carbs_g = :carbsG,
    sugars_g = :sugarsG, fat_g = :fatG, saturated_fat_g = :saturatedFatG, fiber_g = :fiberG, salt_g = :saltG,
    serving_size_g = :servingSizeG, serving_label = :servingLabel, cached_at = :now
WHERE barcode = :barcode AND source = 'OPEN_FOOD_FACTS';

-- Anota una respuesta de OFF. `refreshed` = se aplicó el dato; `summary` = cambio relevante (NULL = ninguno, se
-- conserva el último registrado).
recordRefresh:
INSERT INTO ProductRefreshEntity(barcode, refreshed_at, checked_at, changed_at, change_summary)
VALUES (:barcode, :refreshedAt, :now, CASE WHEN :summary IS NULL THEN NULL ELSE :now END, :summary)
ON CONFLICT(barcode) DO UPDATE SET
    refreshed_at = COALESCE(excluded.refreshed_at, refreshed_at),
    checked_at = excluded.checked_at,
    changed_at = CASE WHEN excluded.change_summary IS NULL THEN changed_at ELSE excluded.changed_at END,
    change_summary = COALESCE(excluded.change_summary, change_summary);

-- Productos de Open Food Facts usados (en el diario o como favoritos) cuya última consulta es anterior a :staleBefore,
-- los más antiguos primero.
selectRefreshCandidates:
SELECT p.barcode FROM ProductEntity AS p
LEFT JOIN ProductRefreshEntity AS r ON r.barcode = p.barcode
WHERE p.source = 'OPEN_FOOD_FACTS'
  AND COALESCE(r.checked_at, r.refreshed_at, p.cached_at) < :staleBefore
  AND (EXISTS (SELECT 1 FROM FavoriteFoodEntity AS f WHERE f.key = p.barcode)
    OR EXISTS (SELECT 1 FROM DiaryEntryEntity AS d WHERE d.barcode = p.barcode))
ORDER BY COALESCE(r.checked_at, r.refreshed_at, p.cached_at), p.barcode
LIMIT :limit;

-- Correcciones del usuario sobre los valores nutricionales de un producto (OFF o genérico), por 100 g (o 100 ml).
-- Tabla aparte de ProductEntity a propósito: refrescar, reimportar o resembrar el producto no las toca, y borrar la
-- corrección devuelve el original. Sin FK: la corrección puede existir (p. ej. importada) antes que el producto.
CREATE TABLE ProductCorrectionEntity (
    barcode TEXT NOT NULL PRIMARY KEY CHECK (length(barcode) > 0),
    kcal REAL,
    protein_g REAL,
    carbs_g REAL,
    sugars_g REAL,
    fat_g REAL,
    saturated_fat_g REAL,
    fiber_g REAL,
    salt_g REAL,
    -- Instante de la última edición, en milisegundos epoch.
    updated_at INTEGER NOT NULL
);

selectCorrection:
SELECT * FROM ProductCorrectionEntity WHERE barcode = ?;

selectAllCorrections:
SELECT * FROM ProductCorrectionEntity ORDER BY barcode;

upsertCorrection:
INSERT INTO ProductCorrectionEntity(
    barcode, kcal, protein_g, carbs_g, sugars_g, fat_g, saturated_fat_g, fiber_g, salt_g, updated_at
) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?)
ON CONFLICT(barcode) DO UPDATE SET
    kcal = excluded.kcal, protein_g = excluded.protein_g, carbs_g = excluded.carbs_g, sugars_g = excluded.sugars_g,
    fat_g = excluded.fat_g, saturated_fat_g = excluded.saturated_fat_g, fiber_g = excluded.fiber_g,
    salt_g = excluded.salt_g, updated_at = excluded.updated_at;

deleteCorrection:
DELETE FROM ProductCorrectionEntity WHERE barcode = ?;
