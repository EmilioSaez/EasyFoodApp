-- Agua bebida: un total en ml por día (la fecha ISO es la clave). Un día a 0 ml no tiene fila.
CREATE TABLE IF NOT EXISTS WaterEntity (
    date TEXT NOT NULL PRIMARY KEY CHECK (length(date) = 10),
    ml INTEGER NOT NULL CHECK (ml > 0 AND ml <= 20000),
    updated_at INTEGER NOT NULL
);

-- Objetivo diario de agua: una única fila (id = 1); sin fila = objetivo por defecto (migración 8.sqm).
CREATE TABLE IF NOT EXISTS WaterGoalEntity (
    id INTEGER NOT NULL PRIMARY KEY CHECK (id = 1),
    goal_ml INTEGER NOT NULL CHECK (goal_ml >= 500 AND goal_ml <= 10000),
    updated_at INTEGER NOT NULL
);

selectAll:
SELECT * FROM WaterEntity ORDER BY date ASC;

selectByDate:
SELECT * FROM WaterEntity WHERE date = ?;

upsert:
INSERT OR REPLACE INTO WaterEntity(date, ml, updated_at) VALUES (?, ?, ?);

deleteByDate:
DELETE FROM WaterEntity WHERE date = ?;

selectGoal:
SELECT * FROM WaterGoalEntity WHERE id = 1;

upsertGoal:
INSERT OR REPLACE INTO WaterGoalEntity(id, goal_ml, updated_at) VALUES (1, ?, ?);

clearGoal:
DELETE FROM WaterGoalEntity;
