-- Diario: una fila por alimento registrado en un día y una comida.
-- Guarda una copia (snapshot) del nombre y de los valores por 100 g del producto,
-- para que el diario no cambie si la caché de productos se actualiza o se purga.
CREATE TABLE DiaryEntryEntity (
    id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    -- Día en formato ISO-8601 (YYYY-MM-DD).
    date TEXT NOT NULL,
    -- BREAKFAST, MID_MORNING (Almuerzo), LUNCH, SNACK (Merienda), DINNER o LATE_SNACK (Recena); ver 7.sqm.
    meal TEXT NOT NULL CHECK (meal IN ('BREAKFAST', 'MID_MORNING', 'LUNCH', 'SNACK', 'DINNER', 'LATE_SNACK')),
    barcode TEXT,
    name TEXT NOT NULL,
    -- Cantidad y su unidad: GRAMS (gramos o ml) o SERVINGS (porciones).
    quantity REAL NOT NULL CHECK (quantity > 0),
    unit TEXT NOT NULL CHECK (unit IN ('GRAMS', 'SERVINGS')),
    -- Tamaño de una porción en g; imprescindible para convertir porciones a gramos.
    serving_size_g REAL,
    -- Valores nutricionales por 100 g; NULL = dato no disponible.
    kcal_100g REAL,
    protein_100g REAL,
    carbs_100g REAL,
    fat_100g REAL,
    -- Instante de creación, en milisegundos epoch (desempata el orden dentro de una comida).
    created_at INTEGER NOT NULL,
    -- 1 = entrada rápida (comer fuera): sin alimento en la base; ver 12.sqm. Se guarda como 100 g cuyos
    -- valores «por 100 g» son los totales de la entrada, así totales, progreso y copia funcionan igual.
    quick INTEGER NOT NULL DEFAULT 0 CHECK (quick IN (0, 1)),
    saturated_fat_100g REAL,
    sugars_100g REAL,
    fiber_100g REAL,
    salt_100g REAL
);

CREATE INDEX diary_entry_date_idx ON DiaryEntryEntity(date, meal);

selectByDate:
SELECT * FROM DiaryEntryEntity WHERE date = ? ORDER BY meal, created_at, id;

selectAll:
SELECT * FROM DiaryEntryEntity ORDER BY date, meal, created_at, id;

-- Kcal por día (días con entradas) entre dos fechas ISO; las entradas sin dato de kcal o en porciones sin tamaño no suman.
selectDailyKcal:
SELECT date,
    SUM(CASE unit
        WHEN 'GRAMS' THEN kcal_100g * quantity / 100.0
        ELSE kcal_100g * serving_size_g * quantity / 100.0
    END) AS kcal
FROM DiaryEntryEntity
WHERE date BETWEEN ? AND ?
GROUP BY date
ORDER BY date;

selectById:
SELECT * FROM DiaryEntryEntity WHERE id = ?;

insert:
INSERT INTO DiaryEntryEntity(
    date, meal, barcode, name, quantity, unit, serving_size_g,
    kcal_100g, protein_100g, carbs_100g, fat_100g, created_at, quick,
    saturated_fat_100g, sugars_100g, fiber_100g, salt_100g
) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

-- Última entrada de cada alimento distinto (clave: EAN o, sin él, el nombre), la más reciente primero.
-- Las entradas rápidas no son alimentos: no salen aquí.
selectRecent:
SELECT e.* FROM DiaryEntryEntity AS e
WHERE e.quick = 0 AND e.id = (
    SELECT e2.id FROM DiaryEntryEntity AS e2
    WHERE e2.quick = 0 AND COALESCE(e2.barcode, lower(e2.name)) = COALESCE(e.barcode, lower(e.name))
    ORDER BY e2.created_at DESC, e2.id DESC LIMIT 1
)
ORDER BY e.created_at DESC, e.id DESC
LIMIT ?;

lastInsertedId:
SELECT last_insert_rowid();

updateQuantityAndMeal:
UPDATE DiaryEntryEntity SET meal = ?, quantity = ?, unit = ? WHERE id = ?;

-- Edita una entrada rápida: comida, nombre y totales (guardados como valores por 100 g de una cantidad de 100 g).
updateQuick:
UPDATE DiaryEntryEntity SET meal = ?, name = ?, kcal_100g = ?, protein_100g = ?, carbs_100g = ?, fat_100g = ?
WHERE id = ? AND quick = 1;

deleteById:
DELETE FROM DiaryEntryEntity WHERE id = ?;
