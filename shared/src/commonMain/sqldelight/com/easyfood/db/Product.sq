-- Caché local de productos. Valores nutricionales por 100 g (o 100 ml); NULL = dato no disponible.
CREATE TABLE ProductEntity (
    barcode TEXT NOT NULL PRIMARY KEY,
    name TEXT NOT NULL,
    brand TEXT,
    image_url TEXT,
    kcal REAL,
    protein_g REAL,
    carbs_g REAL,
    sugars_g REAL,
    fat_g REAL,
    saturated_fat_g REAL,
    fiber_g REAL,
    salt_g REAL,
    serving_size_g REAL,
    serving_label TEXT,
    -- Origen del dato: OPEN_FOOD_FACTS, GENERIC o CUSTOM.
    source TEXT NOT NULL DEFAULT 'OPEN_FOOD_FACTS',
    -- Instante de la última descarga/edición, en milisegundos epoch.
    cached_at INTEGER NOT NULL
);

CREATE INDEX product_name_idx ON ProductEntity(name);

selectByBarcode:
SELECT * FROM ProductEntity WHERE barcode = ?;

selectAll:
SELECT * FROM ProductEntity ORDER BY name;

upsert:
INSERT OR REPLACE INTO ProductEntity(
    barcode, name, brand, image_url, kcal, protein_g, carbs_g, sugars_g, fat_g,
    saturated_fat_g, fiber_g, salt_g, serving_size_g, serving_label, source, cached_at
) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

deleteByBarcode:
DELETE FROM ProductEntity WHERE barcode = ?;
