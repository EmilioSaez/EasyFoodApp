-- Migración 1 -> 2: alimentos propios del usuario.
CREATE TABLE CustomFoodEntity (
    id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    name TEXT NOT NULL,
    brand TEXT,
    kcal REAL NOT NULL CHECK (kcal >= 0),
    protein_g REAL NOT NULL CHECK (protein_g >= 0),
    carbs_g REAL NOT NULL CHECK (carbs_g >= 0),
    fat_g REAL NOT NULL CHECK (fat_g >= 0),
    sugars_g REAL,
    saturated_fat_g REAL,
    fiber_g REAL,
    salt_g REAL,
    serving_size_g REAL CHECK (serving_size_g IS NULL OR serving_size_g > 0),
    serving_label TEXT,
    source TEXT NOT NULL DEFAULT 'CUSTOM' CHECK (source = 'CUSTOM'),
    created_at INTEGER NOT NULL,
    updated_at INTEGER NOT NULL
);

CREATE INDEX custom_food_name_idx ON CustomFoodEntity(name);
